{
    "name": "horde/openxchange",
    "description": "Open-Xchange client library",
    "type": "library",
    "homepage": "https://www.horde.org",
    "license": "LGPL-2.1",
    "authors": [
        {
            "name": "Jan Schneider",
            "email": "jan@horde.org",
            "role": "lead"
        }
    ],
    "keywords": [
        "integration",
        "controller"
    ],
    "time": "2026-04-22",
    "repositories": [],
    "require": {
        "php": "^8.1",
        "horde/date": "^3 || dev-FRAMEWORK_6_0",
        "horde/http": "^3 || dev-FRAMEWORK_6_0",
        "horde/controller": "* || dev-FRAMEWORK_6_0",
        "horde/perms": "^3 || dev-FRAMEWORK_6_0",
        "horde/url": "^3 || dev-FRAMEWORK_6_0"
    },
    "require-dev": {},
    "suggest": {},
    "autoload": {
        "psr-0": {
            "Horde_OpenXchange": "lib/"
        },
        "psr-4": {
            "Horde\\OpenXchange\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\OpenXchange\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {
            "horde/horde-installer-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "2.x-dev"
        }
    }
}
